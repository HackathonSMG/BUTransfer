# Copy to .env and fill in. Never commit .env.

# Site under test. Local dev: frontend :5173 (proxies /api to backend :4000).
# The Azure site is the PRODUCTION slot: only read-only tests run there (ALLOW_SUBMIT=false).
BASE_URL=http://localhost:5173
# BASE_URL=https://transcripts-fqbwfbdkcbcyfcgg.westus3-01.azurewebsites.net

# Optional test staff accounts (test accounts only, never real staff)
ADMIN_EMAIL=
ADMIN_PASSWORD=
OFFICE_EMAIL=
OFFICE_PASSWORD=
EVALUATOR_EMAIL=
EVALUATOR_PASSWORD=

# true = also run tests that create applications. Local or staging only.
ALLOW_SUBMIT=false

# Foundry QA agent (only needed to try the AI report locally; needs `az login`)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_QA_AGENT_NAME=bu-transfer-qa-analyst
